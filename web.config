<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS web.config for Shri Ranchhodji Mandir — Node.js via iisnode
  
  Prerequisites on your Windows Server:
  1. iisnode — https://github.com/azure/iisnode/releases  (install the .msi)
  2. URL Rewrite — https://www.iis.net/downloads/microsoft/url-rewrite
  3. Node.js — https://nodejs.org/en/download (LTS, 64-bit)
  
  After installing all three, restart IIS:
    iisreset
  
  Then in IIS Manager:
  - Add Website → Point to this folder → Set your domain/port
  - App Pool → .NET CLR Version: No Managed Code
-->
<configuration>
  <system.webServer>

    <!-- Route all traffic through iisnode to server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Skip requests for actual static files (images, HTML, video, etc.) -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Route all API calls and other requests to Node.js -->
        <rule name="NodeApp">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Protect secrets and source files from being served directly -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env"   allowed="false" />
          <add fileExtension=".json"  allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- iisnode settings -->
    <iisnode
      node_env="production"
      watchedFiles="web.config;server.js;.env"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      devErrorsEnabled="false"
      enableXFF="true"
    />

  </system.webServer>
</configuration>
