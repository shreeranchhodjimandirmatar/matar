# ─────────────────────────────────────────────────────────────
#  Cashfree Credentials
#
#  HOW TO GET THESE:
#  1. Go to https://merchant.cashfree.com/merchants/signup
#  2. Sign up → complete KYC (Trust / NGO documents)
#  3. Dashboard → Developers → API Keys
#  4. Copy "App ID" and "Secret Key"
#  5. Use "Test" keys first, switch to "Production" when live
#
#  ⚠️  NEVER commit this file to GitHub.
#     .env is listed in .gitignore below.
# ─────────────────────────────────────────────────────────────

# Cashfree API Keys
CASHFREE_APP_ID=YOUR_APP_ID_HERE
CASHFREE_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Environment: "sandbox" for testing, "production" for live
CASHFREE_ENV=sandbox

# Your site's domain (used for return URL after payment)
# Example: https://temple.yourdomain.com
SITE_URL=https://YOUR_DOMAIN_HERE

# Server port (IIS will proxy to this)
PORT=3000
